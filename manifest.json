{
  "manifest_version": 3,
  "name": "bililearn",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "bililearn（WezeShang 二次开发版，原名 bilidown）：把 B 站视频变成可阅读、可跳转、可保存的中文学习资料。默认读取官方字幕，Whisper 按需本地转录，大语言模型生成中文概览、章节时间线、关键观点与笔记。",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "cookies",
    "notifications",
    "declarativeNetRequestWithHostAccess",
    "downloads"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*",
    "https://*.akamaized.net/*",
    "https://*.oss-cn-beijing.aliyuncs.com/*",
    "https://api.minimaxi.com/*",
    "https://api.minimax.io/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*",
    "http://127.0.0.1:7860/*"
  ],
  "action": {
    "default_title": "打开 bililearn",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bililearn_audio",
        "enabled": true,
        "path": "rules/bililearn-audio.json"
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
